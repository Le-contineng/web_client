# Copier ce fichier en .env.local et adapter les valeurs.

# Adresse publique du site (obligatoire)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse publique du stockage des photos, la même que MEDIAS_S3_URL_PUBLIQUE de l'API
# (optionnel). Vide : les photos passent par le site, chaque image coûte une requête Vercel.
# Local : http://localhost:8333/medias ; prod : https://medias.<domaine>
# NEXT_PUBLIC_MEDIA_URL=https://medias.<domaine>

# URL de l'API Spring, côté serveur uniquement (défaut : http://localhost:8080)
API_URL=http://localhost:8080
MEDIAS_STORAGE_ORIGINS=http://localhost:8333

# Fuseau de l'aperçu WhatsApp, calculé côté serveur (optionnel, défaut : Africa/Douala)
# FUSEAU_APERCU=Africa/Douala

# Origine du stockage des photos (ADR 0014 du backend), séparées par des espaces.
# Local (SeaweedFS) : http://localhost:8333 ; préprod : https://<projet>.supabase.co ;
# prod : https://medias.<domaine> https://<compte>.r2.cloudflarestorage.com
# MEDIAS_STORAGE_ORIGINS=http://localhost:8333

# Connexion avec Google (ADR 0019 du backend) : Google Cloud Console → API et services →
# Identifiants → ID client OAuth « Application Web ». Le même ID client va dans GOOGLE_CLIENT_ID
# de l'API. Si l'un manque, le bouton « Continuer avec Google » est masqué.
# URI de redirection autorisée : <adresse du site>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notifications push (ADR 0017) : projet Firebase, valeurs publiques de la console.
# Paramètres du projet → Général → Vos applications (application Web).
# Si l'une manque, les push sont désactivés.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Paramètres du projet → Cloud Messaging → Certificats Web Push → clé publique
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Campagnes de démonstration tant que l'API ne sert pas /api/v1/campaigns/active :
# bds, mix, partner ou announcement. Vide : campagnes de l'API.
# CAMPAIGNS_DEMO=bds
